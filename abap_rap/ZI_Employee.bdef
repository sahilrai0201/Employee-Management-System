managed implementation in class zbp_i_employee unique;
strict ( 2 );
with draft;

define behavior for ZI_Employee alias Employee
persistent table zemployee
draft table zemployee_d
lock master total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateEmployeeID;
    validation validateMandatoryFields;
    validation validateEmail;
    validation validateSalary;
  }

  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;
  field ( mandatory : create ) EmployeeID, FirstName, LastName, Email, Department, JobTitle, JoiningDate, EmploymentType, EmploymentStatus;
  field ( readonly : update ) EmployeeID;

  validation validateEmployeeID on save { field EmployeeID; create; }
  validation validateMandatoryFields on save { field FirstName, LastName, Email, Department, JobTitle; create; update; }
  validation validateEmail on save { field Email; create; update; }
  validation validateSalary on save { field Salary; create; update; }

  determination setDefaultValues on modify { create; }

  mapping for zemployee
  {
    EmployeeID = employee_id;
    FirstName = first_name;
    LastName = last_name;
    Email = email;
    PhoneNumber = phone_number;
    DateOfBirth = date_of_birth;
    Department = department;
    JobTitle = job_title;
    Manager = manager;
    JoiningDate = joining_date;
    EmploymentType = employment_type;
    EmploymentStatus = employment_status;
    OfficeLocation = office_location;
    Salary = salary;
    Currency = currency;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
