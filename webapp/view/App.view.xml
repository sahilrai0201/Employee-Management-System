<mvc:View
  controllerName="corp.ems.employee.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  height="100%">

  <App id="emsRootApp" class="sapUiSizeCompact">
    <pages>
      <Page
        id="shellPage"
        showHeader="true"
        enableScrolling="false"
        backgroundDesign="Solid">
        
        <customHeader>
          <f:ShellBar
            id="fioriShellBar"
            title="{i18n>appTitle}"
            secondTitle="{i18n>appDescription}"
            homeIcon="sap-icon://hr-approval"
            showNotifications="true"
            notificationsNumber="3"
            showProductSwitcher="true"
            notificationsPressed=".onNotificationsPress"
            productSwitcherPressed=".onProductSwitcherPress">
            <f:profile>
              <f:Avatar
                id="userAvatar"
                src=""
                initials="HA"
                displayShape="Circle"
                displaySize="XS"
                press=".onUserProfilePress"/>
            </f:profile>
            <f:additionalContent>
              <Button
                id="btnBackendStatus"
                icon="sap-icon://connected"
                type="Transparent"
                tooltip="SAP Connection &amp; Architecture Info"
                press=".onBackendStatusPress"/>
            </f:additionalContent>
          </f:ShellBar>
        </customHeader>

        <content>
          <!-- Router Host Container -->
          <NavContainer id="appContainer" width="100%" height="100%"/>
        </content>
      </Page>
    </pages>
  </App>
</mvc:View>
