<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" xmlns:sap="http://www.sap.com/Protocols/SAPData">
  <edmx:DataServices m:DataServiceVersion="2.0">
    <Schema Namespace="ZEMPLOYEE_SRV" xml:lang="en" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">
      <EntityType Name="Employee" sap:content-version="1">
        <Key>
          <PropertyRef Name="EmployeeID"/>
        </Key>
        <Property Name="EmployeeID" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Employee ID" sap:creatable="true" sap:updatable="false" sap:filterable="true"/>
        <Property Name="FirstName" Type="Edm.String" Nullable="false" MaxLength="40" sap:label="First Name" sap:creatable="true" sap:updatable="true"/>
        <Property Name="LastName" Type="Edm.String" Nullable="false" MaxLength="40" sap:label="Last Name" sap:creatable="true" sap:updatable="true"/>
        <Property Name="FullName" Type="Edm.String" MaxLength="80" sap:label="Full Name" sap:creatable="false" sap:updatable="false" sap:filterable="true"/>
        <Property Name="Email" Type="Edm.String" Nullable="false" MaxLength="100" sap:label="Email Address" sap:creatable="true" sap:updatable="true" sap:filterable="true"/>
        <Property Name="PhoneNumber" Type="Edm.String" MaxLength="30" sap:label="Phone" sap:creatable="true" sap:updatable="true"/>
        <Property Name="DateOfBirth" Type="Edm.DateTime" Precision="0" sap:display-format="Date" sap:label="Birth Date"/>
        <Property Name="Department" Type="Edm.String" Nullable="false" MaxLength="50" sap:label="Department" sap:creatable="true" sap:updatable="true" sap:filterable="true"/>
        <Property Name="JobTitle" Type="Edm.String" Nullable="false" MaxLength="60" sap:label="Job Title" sap:creatable="true" sap:updatable="true" sap:filterable="true"/>
        <Property Name="Manager" Type="Edm.String" MaxLength="80" sap:label="Reporting Manager" sap:creatable="true" sap:updatable="true"/>
        <Property Name="JoiningDate" Type="Edm.DateTime" Precision="0" sap:display-format="Date" sap:label="Joining Date" Nullable="false" sap:filterable="true"/>
        <Property Name="EmploymentType" Type="Edm.String" Nullable="false" MaxLength="20" sap:label="Type" sap:filterable="true"/>
        <Property Name="EmploymentStatus" Type="Edm.String" Nullable="false" MaxLength="20" sap:label="Status" sap:filterable="true"/>
        <Property Name="OfficeLocation" Type="Edm.String" MaxLength="50" sap:label="Location"/>
        <Property Name="Salary" Type="Edm.Decimal" Precision="13" Scale="2" sap:label="Salary" sap:unit="Currency"/>
        <Property Name="Currency" Type="Edm.String" MaxLength="3" sap:label="Currency" sap:semantics="currency-code"/>
        <Property Name="StatusCriticality" Type="Edm.Int32" sap:label="Status Criticality"/>
      </EntityType>

      <EntityType Name="Department" sap:content-version="1">
        <Key>
          <PropertyRef Name="DepartmentID"/>
        </Key>
        <Property Name="DepartmentID" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Dept ID"/>
        <Property Name="DepartmentName" Type="Edm.String" Nullable="false" MaxLength="50" sap:label="Department Name"/>
        <Property Name="Head" Type="Edm.String" MaxLength="80" sap:label="Head of Department"/>
        <Property Name="CostCenter" Type="Edm.String" MaxLength="20" sap:label="Cost Center"/>
      </EntityType>

      <EntityType Name="Manager" sap:content-version="1">
        <Key>
          <PropertyRef Name="ManagerID"/>
        </Key>
        <Property Name="ManagerID" Type="Edm.String" Nullable="false" MaxLength="10" sap:label="Manager ID"/>
        <Property Name="ManagerName" Type="Edm.String" Nullable="false" MaxLength="80" sap:label="Manager Name"/>
        <Property Name="Department" Type="Edm.String" MaxLength="50" sap:label="Department"/>
        <Property Name="JobTitle" Type="Edm.String" MaxLength="60" sap:label="Designation"/>
      </EntityType>

      <EntityContainer Name="ZEMPLOYEE_SRV_Entities" m:IsDefaultEntityContainer="true" sap:supported-formats="atom json">
        <EntitySet Name="EmployeeSet" EntityType="ZEMPLOYEE_SRV.Employee" sap:creatable="true" sap:updatable="true" sap:deletable="true" sap:searchable="true" sap:content-version="1"/>
        <EntitySet Name="DepartmentSet" EntityType="ZEMPLOYEE_SRV.Department" sap:creatable="false" sap:updatable="false" sap:deletable="false" sap:content-version="1"/>
        <EntitySet Name="ManagerSet" EntityType="ZEMPLOYEE_SRV.Manager" sap:creatable="false" sap:updatable="false" sap:deletable="false" sap:content-version="1"/>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
